{
  "projects": {
    "default": "miayudatics-prod",
    "qa": "miayudatics-qa"
  },
  "targets": {
    "miayudatics-prod": {
      "hosting": [
        {
          "target": "miayudatics-prod",
          "project": "miayudatics-prod",
          "rewrite": [
            {
              "source": "/**",
              "destination": "/index.html"
            }
          ],
          "headers": [
            {
              "source": "/**/*.(png|jpg|jpeg|svg|webp|ico|mmdb)",
              "headers": [
                {
                  "key": "Cache-Control",
                  "value": "public, max-age=31536000, immutable"
                }
              ]
            }
          ]
        }
      ]
    },
    "miayudatics-qa": {
      "hosting": [
        {
          "target": "qa",
          "project": "miayudatics-qa",
          "public": "client/dist",
          "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
          ],
          "rewrites": [
            {
              "source": "/**",
              "destination": "/index.html"
            }
          ],
          "headers": [
            {
              "source": "/**/*.(png|jpg|jpeg|svg|webp|ico|mmdb)",
              "headers": [
                {
                  "key": "Cache-Control",
                  "value": "public, max-age=31536000, immutable"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
