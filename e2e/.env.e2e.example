# Copy to e2e/.env.e2e (gitignored). Never commit real passwords.

E2E_FRONTEND_URL=https://miayudatics.vercel.app
E2E_BACKEND_URL=https://miayudatics-v1-0.onrender.com

# Read-only Playwright smoke (optional)
E2E_LIDER_EMAIL=
E2E_LIDER_PASSWORD=
E2E_FUNCA_EMAIL=
E2E_FUNCA_PASSWORD=

# Set true only after Render has the health CORS change from Phase 0.5
E2E_EXPECT_HEALTH_CORS=false

# Destructive workflow v2 — keep false. Production host is refused.
RUN_DESTRUCTIVE_E2E=false
E2E_ENV=simulation
E2E_TECNICO_EMAIL=
E2E_TECNICO_PASSWORD=
