{
  "name": "miayudatics-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "open:emulator": "node scripts/open-emulator-app.mjs",
    "open:physical": "node scripts/open-physical-app.mjs",
    "dev:usb": "node scripts/adb-reverse.mjs && expo start --dev-client --localhost",
    "dev:lan": "expo start --dev-client --lan",
    "adb": "node scripts/adb-reverse.mjs",
    "native:sync": "node scripts/native-sync.mjs",
    "native:build:dev": "node scripts/native-build-dev.mjs",
    "native:build:dev:clean": "node scripts/native-build-dev.mjs --clean",
    "native:build:release": "node scripts/native-build-release.mjs",
    "deeplink:test": "node scripts/deeplink-test.mjs",
    "deeplink:test:https": "node scripts/deeplink-test.mjs --https",
    "fingerprint:android": "node scripts/android-fingerprint.mjs",
    "sync:assetlinks": "node scripts/sync-assetlinks.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "start": "pnpm dev:emulator"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.11",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.17",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.56.4",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
